# =============================================================================
# Root .gitignore for TechCycle Platform
# =============================================================================

# --- Dependencies & Runtimes ---
node_modules/
/.pnp
.pnp.js
venv/
backend/venv/
env/
ENV/
env.bak/
venv.bak/

# --- Environment Variables & Secrets ---
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# --- Operating System & Editor Files ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# --- Python Cache & Build Artifacts ---
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.coverage
htmlcov/
dist/
build/
develop-eggs/
downloads/
eggs/
.eggs/
parts/
var/
sdist/
*.egg-info/
.installed.cfg
*.egg

# --- Logs ---
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.log

# --- Large Archives & Training Bundles ---
*.zip
*.tar.gz
*.tgz
*.rar
*.7z
techcycle_training_bundle.zip

# --- Machine Learning Models, Binaries & Checkpoints ---
*.h5
*.keras
*.pb
*.onnx
*.tflite
*.pt
*.pth
*.weights.h5
checkpoints/
backend/checkpoints/
backend/models/*.keras
backend/models/*.h5

# --- Temporary Executables & Scratch Runners ---
*.exe
*.out
*.app
tempCodeRunnerFile.*

# --- Dataset Directories (Keep Git lightweight) ---
backend/data/images/
backend/processed_images/
